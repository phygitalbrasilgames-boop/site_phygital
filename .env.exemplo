# Copie para .env e preencha. O .env não vai para o repositório.
#
# O Node não lê .env sozinho. Use uma destas formas:
#   PowerShell:  Get-Content .env | ForEach-Object { if ($_ -match '^(\w+)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1], $matches[2]) } }; npm start
#   Bash:        set -a && . ./.env && set +a && npm start
#   Node 20+:    node --env-file=.env server/index.js

# ---------------------------------------------------------------------------
# SERVIDOR
# ---------------------------------------------------------------------------

# dev      → nada de e-mail sai de verdade (fica como 'simulado' no banco) e o
#            código de verificação aparece na resposta da API, para facilitar teste
# producao → e-mail vai para a fila real e o código nunca é devolvido na resposta
PHYGITAL_MODO=dev

PHYGITAL_PORTA=3000

# Endereço público do site. Entra nas imagens e nos links dos e-mails enviados.
# Sem isto o padrão é http://localhost:3000, e o logo chega quebrado para quem
# recebe — localhost só existe na máquina que enviou.
# PHYGITAL_URL=https://phygitalbrasilgames-boop.github.io/site_phygital

# Pasta do banco SQLite. Padrão: ./dados
# PHYGITAL_DADOS=./dados

# ---------------------------------------------------------------------------
# SENHAS DA PRIMEIRA SEMEADURA
#
# Lidas só quando o banco é criado/recriado. Se ficarem vazias, a semeadura
# gera senha aleatória forte e imprime UMA vez no terminal.
#
# O briefing traz uma senha em texto puro no PDF. Ela NÃO deve ser usada: era
# semente de primeiro acesso e precisa ser trocada.
# ---------------------------------------------------------------------------

PHYGITAL_ADMIN_SENHA=
PHYGITAL_COMPETIDOR_SENHA=

# ---------------------------------------------------------------------------
# SMTP
#
# Só usada quando PHYGITAL_MODO=producao. A senha nunca é gravada no banco nem
# devolvida por nenhuma rota da API.
# ---------------------------------------------------------------------------

PHYGITAL_SMTP_SENHA=
