{
  // Ambiente do GitHub Codespaces.
  //
  // É o que dá o "link do GitHub" com o backend rodando de verdade: o Codespaces
  // encaminha a porta 3000 e gera uma URL pública
  //   https://<nome-do-codespace>-3000.app.github.dev
  //
  // O GitHub Pages não serve para isso — ele só entrega arquivos estáticos, sem
  // processo Node e sem banco.
  //
  // Para o envio real de e-mail funcionar aqui, uma vez só:
  //   1. Abra https://github.com/settings/codespaces
  //   2. Em "Repository access secrets", cadastre PHYGITAL_SMTP_SENHA
  //   3. Autorize o repositório phygitalbrasilgames-boop/site_phygital
  //   4. Se o codespace já estava aberto, "Rebuild Container"
  // Sem o secret o servidor ainda sobe, mas em modo simulado.
  "name": "Site Phygital — Node + SQLite",

  // Node 24: o módulo node:sqlite usado pelo projeto exige 22.5 ou mais.
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24-bookworm",

  "forwardPorts": [3000],

  "portsAttributes": {
    "3000": {
      "label": "Site Phygital",
      "onAutoForward": "openBrowser",
      // "public" deixa a URL da porta 3000 aberta sem exigir login do GitHub —
      // é o que permite mandar o link para outra pessoa testar (cliente, chefe)
      // sem que ela precise ser colaboradora do repositório.
      "visibility": "public"
    }
  },

  // Semeadura + alinhamento das senhas de teste. Sem npm install: o projeto não
  // tem dependência nenhuma (o servidor usa node:sqlite embutido).
  "postCreateCommand": "node scripts/setup-codespaces.cjs",

  // Toda vez que o codespace anexa: sobe o servidor com o .env carregado se
  // existir, senão só com o ambiente do devcontainer. Sai como processo do
  // shell — o "Rebuild Container" ou "Stop Codespace" o encerra junto.
  "postAttachCommand": {
    "servidor": "if [ -f .env ]; then node --env-file=.env server/index.js 3000; else node server/index.js 3000; fi"
  },

  "remoteEnv": {
    // "producao" desperta o SMTP real quando PHYGITAL_SMTP_SENHA está no
    // ambiente. Sem a senha, statusDeEnvio() ainda cai em 'simulado' — a trava
    // dupla continua valendo.
    "PHYGITAL_MODO": "producao",
    "PHYGITAL_PORTA": "3000",
    // Libera o envio real quando a senha estiver presente. É a mesma travinha
    // que existe no .env local — proteção deliberada contra "exportei a senha
    // sem querer e mandei e-mail para os semeados".
    "PHYGITAL_EMAIL_REAL": "1"
    // PHYGITAL_URL fica de fora de propósito: server/email.js lê CODESPACE_NAME
    // em runtime (o Codespaces injeta em todo shell) e monta a URL pública
    // sozinho. Colocar aqui congelaria o valor no rebuild e pisaria em cima
    // de qualquer ambiente que não seja Codespaces.
  },

  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint"],
      "settings": {
        "files.eol": "\n"
      }
    }
  }
}
